<view class="page">
  <view class="header">
    <text class="title">Second Brain</text>
    <button class="sync-button" bindtap="onTapSync" loading="{{loading}}">Sync</button>
  </view>
  <view class="status" wx:if="{{error}}">
    <text class="error">{{error}}</text>
  </view>
  <view class="list">
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="item-header">
        <text class="item-title">{{item.title}}</text>
        <text class="item-type">{{item.type}}</text>
      </view>
      <text class="item-content">{{item.content}}</text>
    </view>
  </view>
  <view class="empty" wx:if="{{items.length === 0 && !loading}}">
    <text>No data yet. Pull down or tap sync.</text>
  </view>
</view>
