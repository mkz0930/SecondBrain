# 生产环境配置文件示例
# 复制此文件为 .env.production 并填入实际值

# ==================== 服务器配置 ====================
# 后端服务端口
PORT=3000

# Node 环境
NODE_ENV=production

# ==================== AI 服务配置 ====================
# Google Generative AI API Key（必需，用于内容分析、摘要生成等）
# 获取地址：https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# 或使用 Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here

# ==================== 数据库配置 ====================
# SQLite 数据库文件路径
DB_PATH=./data/brain.db

# ==================== 用户认证配置 ====================
# 是否禁用匿名访问（true/false）
DISABLE_ANON=false

# JWT 密钥（可选，用于 token 签名）
# JWT_SECRET=your_random_secret_key_here

# ==================== 飞书集成配置 ====================
# 是否启用飞书同步（true/false）
FEISHU_SYNC_ENABLED=true

# 飞书应用凭证（如需使用飞书同步功能）
# FEISHU_APP_ID=your_feishu_app_id
# FEISHU_APP_SECRET=your_feishu_app_secret

# ==================== 微信小程序配置 ====================
# 微信小程序凭证（如需使用微信登录）
# WECHAT_APP_ID=your_wechat_app_id
# WECHAT_APP_SECRET=your_wechat_app_secret

# ==================== 日志配置 ====================
# 日志级别（error, warn, info, debug）
LOG_LEVEL=info

# 日志文件保留天数
LOG_MAX_FILES=30d

# ==================== 其他配置 ====================
# 允许的跨域来源（生产环境建议设置具体域名）
# CORS_ORIGIN=https://machang.tech

# 文件上传大小限制（MB）
# MAX_FILE_SIZE=10
