# 环境配置示例文件
# 复制此文件为 .env 并填入实际值

# API 服务器地址
# 开发环境（Android 模拟器）
API_BASE_URL=http://10.0.2.2:3000

# 开发环境（真机，替换为你的电脑 IP）
# API_BASE_URL=http://192.168.1.100:3000

# 生产环境
# API_BASE_URL=https://your-production-server.com

# 应用配置
APP_NAME=外挂大脑
APP_VERSION=1.1.0

# 剪贴板监听配置
CLIPBOARD_CHECK_INTERVAL=2000  # 检查间隔（毫秒）
CLIPBOARD_IDLE_INTERVAL=5000   # 空闲时检查间隔（毫秒）
CLIPBOARD_IDLE_THRESHOLD=60000 # 空闲阈值（毫秒）

# 同步配置
SYNC_INTERVAL=5                # 自动同步间隔（分钟）
SYNC_BATCH_SIZE=3              # 批量同步并发数
SYNC_RETRY_DELAYS=1000,5000,15000,60000  # 重试延迟（毫秒）

# 性能监控配置
PERFORMANCE_ENABLED=true       # 是否启用性能监控
PERFORMANCE_MAX_ERRORS=50      # 最多保存错误数量

# 日志配置
LOG_LEVEL=info                 # 日志级别: debug, info, warn, error
LOG_MAX_ENTRIES=200            # 最多保存日志条数

# 通知配置
NOTIFICATION_SOUND=false       # 是否播放声音
NOTIFICATION_VIBRATE=false     # 是否震动

# 调试配置
DEBUG_MODE=false               # 调试模式
ENABLE_CONSOLE_LOGS=true       # 是否输出控制台日志
