# Server Configuration
PORT=3000

# Feishu Integration
# 飞书加密密钥（用于加密存储app_secret），请修改为32位随机字符串
FEISHU_ENCRYPTION_KEY=your-32-character-encryption-key-here

# 是否启用飞书自动同步（true/false）
FEISHU_SYNC_ENABLED=true

# 默认同步间隔（分钟）
FEISHU_SYNC_DEFAULT_INTERVAL=15

# User Management
# 是否禁用匿名用户（true/false）
DISABLE_ANON=false
